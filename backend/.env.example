NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/lockship
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=15m
BCRYPT_SALT_ROUNDS=12
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
SMTP_HOST=
SMTP_PORT=587
# STARTTLS is mandatory whenever SMTP_SECURE=false.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
UNLOCK_CODE_TTL_MINUTES=10
UNLOCK_CODE_MAX_ATTEMPTS=5
UNLOCK_CODE_ENCRYPTION_KEY=replace-this-with-a-separate-random-secret-at-least-32-characters-long
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=lockship-backend
MQTT_PASSWORD=replace-with-broker-password
MQTT_CLIENT_ID=lockship-backend
MQTT_DEVICE_TOKEN_SECRET=replace-with-a-separate-random-secret-at-least-32-characters-long
MQTT_DEVICE_TOKEN_TTL=365d
MQTT_OFFLINE_AFTER_SECONDS=90