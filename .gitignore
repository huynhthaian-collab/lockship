# Root .gitignore for Lockship Monorepo

# Dependencies
node_modules/
**/node_modules/
package-lock.json.bak

# Production Builds
dist/
**/dist/
dist-ssr/
**/dist-ssr/
build/
**/build/
.next/
**/.next/

# Environment Variables & Secrets (CRITICAL: Never commit .env files)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS files
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
